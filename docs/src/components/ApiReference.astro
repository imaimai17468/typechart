      <summary>PieChart</summary>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Prop</th>
              <th>Type</th>
              <th>Default</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>value</code></td>
              <td><code>number</code></td>
              <td><em>required</em></td>
              <td>Single value 0–100 representing percentage. Values over 100 are clamped</td>
            </tr>
