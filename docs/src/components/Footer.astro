---
---

<footer>
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">typechart</span>
      <p class="footer-tagline">Inline charts powered by a variable font.</p>
    </div>
    <div class="footer-links">
      <a href="https://github.com/imaimai17468/typechart" target="_blank" rel="noopener">GitHub</a>
      <a href="#demos">Demos</a>
      <a href="#install">Install</a>
      <a href="#api">API</a>
    </div>
  </div>
  <div class="container footer-legal">
    <span>MIT License</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 3rem 0 2rem;
    background: var(--bg-subtle);
  }

  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .footer-logo {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    display: block;
    margin-bottom: 0.4rem;
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
